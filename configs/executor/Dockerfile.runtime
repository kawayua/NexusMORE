# First-release Linux amd64 executor; keep historical Dockerfiles unchanged.
FROM docker.m.daocloud.io/library/python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
RUN pip install --no-cache-dir numpy==2.3.1 scipy==1.16.0 openpyxl==3.1.5
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
USER 10001:10001

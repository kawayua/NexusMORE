  "assumptions": [
    {
      "id": "rigid",
      "statement": "板凳刚性、把手理想铰接；共享孔中心为同一点，忽略间隙",
      "source_id": "statement"
    }
  ],
  "constraints": [
    {
      "id": "head_arc",
      "expression": "S(theta_initial)-S(theta_head(t))=head_speed*t",
      "meaning": "龙头匀速沿螺线盘入",
      "check_id": "head_speed"
    },
    {
      "id": "chord",
      "expression": "norm(P_j-P_(j-1))=head_gap if j=1 else body_gap",
      "meaning": "固定欧氏孔距，不是弧长差",
      "check_id": "rod_distance"
    },
    {
      "id": "velocity_relation",
      "expression": "(P_j-P_(j-1)) dot (V_j-V_(j-1))=0",
      "meaning": "刚性连杆长度对时间导数为零",
      "check_id": "velocity_fd"
    }
  ],
  "method": {
    "steps": [
      "由螺线弧长反演龙头极角",
      "按固定直线孔距逐个求外侧最近根",
      "对连接约束求导递推速度",
      "导出前保留浮点精度；Excel显示六位小数"
    ],
    "root_selection": "外侧最近根，0<delta<π内严格单调；检查节点顺序，禁止跳圈",

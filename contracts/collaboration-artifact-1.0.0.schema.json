{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "task_graph",
        "source",
        "method_selection",
        "contract",
        "mathematics",
        "code",
        "input",
        "execution",
        "result",
        "figure",
        "reproduction",
        "outline",
        "manuscript",
        "figure_selection",
        "render"
      ],
      "title": "Kind",
      "type": "string"
    },
    "path": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "author_call_ids": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Author Call Ids",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "kind",
    "path",
    "sha256",
    "author_call_ids"
  ],
  "title": "Artifact",
  "type": "object"
}
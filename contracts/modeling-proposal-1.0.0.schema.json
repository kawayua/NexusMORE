{
  "$defs": {
    "Edit": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "op": {
          "enum": [
            "add",
            "replace",
            "remove"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "maxLength": 300,
          "minLength": 2,
          "title": "Path",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "op",
        "path"
      ],
      "title": "Edit",
      "type": "object"
    },
    "SourceDecision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "citation_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "adopted",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "adaptation": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Adaptation",
          "type": "string"
        },
        "limitations": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Limitations",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "decision",
        "reason",
        "adaptation",
        "limitations"
      ],
      "title": "SourceDecision",
      "type": "object"
    },
    "TaskNode": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "conclusion_type": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Conclusion Type",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "id",
        "scope",
        "conclusion_type"
      ],
      "title": "TaskNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_graph": {
      "items": {
        "$ref": "#/$defs/TaskNode"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Task Graph",
      "type": "array"
    },
    "edits": {
      "items": {
        "$ref": "#/$defs/Edit"
      },
      "maxItems": 60,
      "title": "Edits",
      "type": "array"
    },
    "source_decisions": {
      "items": {
        "$ref": "#/$defs/SourceDecision"
      },
      "maxItems": 20,
      "title": "Source Decisions",
      "type": "array"
    },
    "proposal": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Proposal",
      "type": "string"
    },
    "questions": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "task_graph",
    "proposal"
  ],
  "title": "Proposal",
  "type": "object"
}
    "quality": [
      "M1",
      "P1",
      "P2",
      "W1",
      "W2"
    ]
  },
  "limits": {
    "max_inputs": 8,
    "max_input_bytes": 8388608,
    "max_context_bytes": 200000,
    "max_sections": 3,
    "timeout_seconds": 90,
    "max_artifact_bytes": 25165824
  },
  "tools": {
    ".pdf": {
      "id": "pdf-read",
      "adapter": "pdf_read",
      "guide": "document-tools/upstream/pdf/SKILL.md",
      "dependencies": [
        "pypdf"
      ],
      "state": "registered_read_only",
      "execution_environment": "installed_python_subprocess"
    },
    ".xlsx": {
      "id": "spreadsheet-read",
      "adapter": "xlsx_read",
      "guide": "document-tools/upstream/xlsx/SKILL.md",

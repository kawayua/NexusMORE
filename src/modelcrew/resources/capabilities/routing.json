        "openpyxl"
      ],
      "state": "registered_read_only",
      "execution_environment": "installed_python_subprocess"
    },
    ".docx": {
      "id": "word-structure-check",
      "adapter": "docx_validate",
      "guide": "document-tools/upstream/docx/SKILL.md",
      "dependencies": [
        "lxml",
        "defusedxml"
      ],
      "state": "registered_read_only",
      "execution_environment": "installed_python_subprocess"
    }
  },

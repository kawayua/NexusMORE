{
  "schema_version": "1.0.0",
  "routing_version": "1.0.0",
  "backend": "python",
  "scope": "Program-owned reference selection and registered read-only document tools; no solver or approval authority",
  "roles": {
    "modeling": [
      "planning",
      "modeling"
    ],
    "coding": [
      "GENERATE_MINIMAL",
      "GENERATE_FULL"
    ],
    "writing": [

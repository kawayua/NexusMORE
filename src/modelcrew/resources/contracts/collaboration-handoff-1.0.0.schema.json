{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "contract_version": {
          "minimum": 1,
          "title": "Contract Version",
          "type": "integer"
        },
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "execution_id": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Id"
        },
        "result_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Revision"
        }
      },
      "required": [
        "task_id",
        "contract_version",
        "contract_sha256"
      ],
      "title": "Binding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sender": {
      "enum": [
        "modeling",
        "coding",
        "writing"
      ],
      "title": "Sender",
      "type": "string"
    },
    "recipient": {
      "enum": [
        "modeling",
        "coding",
        "writing"
      ],
      "title": "Recipient",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "artifact_ids": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Artifact Ids",
      "type": "array"
    }
  },
  "required": [
    "sender",
    "recipient",
    "snapshot_sha256",
    "binding",
    "artifact_ids"
  ],
  "title": "Handoff",
  "type": "object"
}
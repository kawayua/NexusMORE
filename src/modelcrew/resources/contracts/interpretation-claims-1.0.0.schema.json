{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "output_id": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "maxItems": 8
                      }
                    },
                    "required": [
                      "index"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "reduce": {
                        "enum": [
                          "min",
                          "max",
                          "mean"
                        ]
                      }
                    },
                    "required": [
                      "reduce"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "artifact_sha256",
              "output_id",
              "field",
              "selector"
            ],
            "additionalProperties": false
          },
          "operator": {
            "enum": [
              "eq",
              "le",
              "ge"
            ]
          },
          "expected": {
            "type": "number"
          },
          "compare_to": {
            "type": "object",
            "properties": {
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "output_id": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "maxItems": 8
                      }
                    },
                    "required": [
                      "index"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "reduce": {
                        "enum": [
                          "min",
                          "max",
                          "mean"
                        ]
                      }
                    },
                    "required": [
                      "reduce"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "artifact_sha256",
              "output_id",
              "field",
              "selector"
            ],
            "additionalProperties": false
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "abs_tolerance": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "source",
          "operator",
          "unit",
          "abs_tolerance"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "expected"
            ],
            "not": {
              "required": [
                "compare_to"
              ]
            }
          },
          {
            "required": [
              "compare_to"
            ],
            "not": {
              "required": [
                "expected"
              ]
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "claims"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-bound interpretation claims v1.0.0"
}

{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "check_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "explanation"
      ],
      "title": "Check",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "selector": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Selector",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "selector"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "check_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        },
        "domain": {
          "enum": [
            "model",
            "implementation",
            "explanation",
            "writing",
            "infrastructure"
          ],
          "title": "Domain",
          "type": "string"
        },
        "target": {
          "enum": [
            "modeling",
            "coding",
            "writing",
            "recovery"
          ],
          "title": "Target",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "recheck": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Recheck",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "severity",
        "domain",
        "target",
        "reason",
        "recheck"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ticket_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ticket Sha256",
      "type": "string"
    },
    "reviewer_call_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Reviewer Call Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "title": "Status",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "ticket_sha256",
    "reviewer_call_id",
    "status",
    "checks"
  ],
  "title": "Receipt",
  "type": "object"
}
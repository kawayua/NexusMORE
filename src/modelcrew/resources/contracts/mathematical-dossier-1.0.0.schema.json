{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelcrew.local/contracts/mathematical-dossier-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
    },
    "structure": {
      "type": "string",
      "minLength": 1
    },
    "problem_setting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "string",
          "minLength": 1
        },
        "requested_conclusion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope",
        "inputs",
        "requested_conclusion"
      ]
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "latex": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "shape": {
            "type": "string",
            "minLength": 1
          },
          "first_definition": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
          }
        },
        "required": [
          "latex",
          "meaning",
          "unit",
          "domain",
          "shape",
          "first_definition",
          "scope",
          "id"
        ]
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
          }
        },
        "required": [
          "statement",
          "type",
          "source",
          "impact",
          "id"
        ]
      },
      "minItems": 1
    },
    "equations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
          },
          "latex": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "lhs_dimension": {
            "type": "string",
            "minLength": 1
          },
          "rhs_dimension": {
            "type": "string",
            "minLength": 1
          },
          "evidence_type": {
            "type": "string",
            "minLength": 1
          },
          "symbol_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
            },
            "minItems": 1
          },
          "assumption_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
            },
            "minItems": 0
          },
          "required_symbol_units": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "latex",
          "meaning",
          "lhs_dimension",
          "rhs_dimension",
          "evidence_type",
          "symbol_ids",
          "assumption_ids",
          "required_symbol_units"
        ]
      },
      "minItems": 1
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "equation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
            },
            "minItems": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "derived",
              "proved",
              "conditional",
              "needs_review",
              "numerically_observed"
            ]
          },
          "open_gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "conditions",
          "equation_ids",
          "steps",
          "status",
          "open_gaps"
        ]
      },
      "minItems": 1
    },
    "propositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "equation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_:./-]*$"
            },
            "minItems": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "derived",
              "proved",
              "conditional",
              "needs_review",
              "numerically_observed"
            ]
          },
          "open_gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "conditions",
          "equation_ids",
          "steps",
          "status",
          "open_gaps"
        ]
      },
      "minItems": 0
    },
    "unproved_or_out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "statistical_inference": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "structure",
    "problem_setting",
    "symbols",
    "assumptions",
    "equations",
    "derivations",
    "propositions",
    "unproved_or_out_of_scope",
    "statistical_inference"
  ]
}

    },
    {
      "id": "LAT-006",
      "source_logical_path": "tools/latex/scripts/latex_paper.py",
      "line": 671,
      "domain": "pdf-font-and-raster-audit",
      "assessment": "Type3 and Standard 14 fonts are treated as embedded; audit inspects page-level fonts and Type0 descendants but not Form XObject font resources. Text/content extraction errors are swallowed to empty values; pdfimages output with no parsed rows is not independently distinguished from a genuinely vector-only PDF. Retain actual warnings and current recursive inventory; do not claim complete visual audit."
    },
    {
      "id": "LAT-007",
      "source_logical_path": "tools/latex/scripts/latex_paper.py",
      "line": 89,
      "domain": "path-and-history",
      "assessment": "Writable policy only excludes inferred SKILL_ROOT. Authoritative PROJECT_ROOT is inferred as the LaTeX project parent, not the configured NexusMORE data root. Symlink checks do not explicitly cover Windows junctions. --overwrite and reused build filenames conflict with preserving approved versions; use actual local containment and new version directories."
    },
    {
      "id": "LAT-008",
      "source_logical_path": "tools/latex/scripts/latex_paper.py",
      "line": 1200,
      "domain": "warning-exceptions",
      "assessment": "Warning allowances use unbounded regex search and a nonempty reason; broad expressions can allow every warning. Such a reason cannot act as user approval, scoped policy exception or independent review. Undefined references remain fatal separately."
    },
    {
      "id": "LAT-009",
      "source_logical_path": "tools/latex/scripts/latex_paper.py",
      "line": 1322,
      "domain": "compiler-boundaries",
      "assessment": "Temporary-copy compilation, -no-shell-escape, latexmk -norc and openin_any/openout_any are useful defenses, not a complete OS sandbox or proof of no network/reads through packages. Regex checks of expanded tex do not parse all macros or inspect arbitrary class/style/package execution."
    },
    {
      "id": "LAT-010",
      "source_logical_path": "tools/latex/scripts/latex_paper.py",
      "line": 1335,
      "domain": "failure-evidence-and-atomicity",
      "assessment": "Nonzero compiler exit or timeout raises before durable build output/manifest is written; TemporaryDirectory then removes the isolated logs. Paired PDF/manifest replacement rolls back ordinary exceptions, but is not crash-atomic and reuses build paths. Preserve full commands/logs/failures in immutable attempt directories."
    },

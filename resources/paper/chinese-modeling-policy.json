{
  "policy_version": "1.1.0",
  "language": "zh-CN",
  "genre": "chinese_mathematical_modeling",
  "first_delivery": "markdown",
  "required_sections": [
    "摘要",
    "关键词",
    "问题重述",
    "问题分析",
    "模型假设",
    "符号说明",
    "模型建立",
    "模型求解",
    "结果分析",
    "误差分析与模型检验",
    "模型评价与推广",
    "结论",
    "参考文献"
  ],
  "math_reasoning_scope": [
    "equation_derivation",
    "proof",
    "formula_correctness_check"
  ],
  "math_reasoning_must_not_control": [
    "paper_outline",
    "paper_language",
    "paper_style",
    "figure_policy",
    "final_layout"
  ],
  "figures": {
    "minimum_candidates": 9,
    "minimum_per_category": 3,
    "categories": [
      "raw",
      "process",
      "result"
    ],
    "minimum_formal": 8,
    "minimum_per_question_per_category": 1,
    "minimum_formal_per_question": 1,
    "required_formats": [
      "png",
      "pdf",
      "svg"
    ],
    "minimum_png_dpi": 300,
    "count_logical_figures_not_formats_or_panels": true,
    "require_caption_and_body_reference": true
  },
  "export_requires_reviewed_markdown_sha256": true,
  "internal_terms_forbidden": [
    "C+ Mathematical Export Probe",
    "完整语义快照",
    "contract_sha256",
    "execution_id",
    "M1/P1/P2",
    "Checkpoint",
    "质检回执"
  ],
  "minimum_chinese_ratio": 0.65,
  "official_rules_status": "not_verified_research_template_only",
  "symbol_table": {
    "scope": "whole_paper",
    "section": "符号说明",
    "logical_table_count": 1,
    "placement": "after_assumptions_before_models",
    "split_by_question": false,
    "columns": [
      "symbol",
      "meaning",
      "unit",
      "applicable_scope"
    ],
    "optional_columns": [
      "dimension",
      "subscripts",
      "domain"
    ],
    "merge_only_verified_same_meaning_and_unit": true,
    "resolve_name_or_unit_conflicts_before_export": true,
    "propagate_explicit_renames_to": [
      "prose",
      "equations",
      "figures",
      "tables",
      "references"
    ],
    "keep_local_source_tables_for_traceability": true,
    "allow_continued_table_across_pages": true,
    "source": "explicit_user_requirement"
  }
}
